PORT=8000

# MongoDB. Chạy local bằng `npm run db:up` ở thư mục gốc repo (docker-compose.yml).
MONGO_URL=

# SETUP ACCESS TOKEN
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_EXPIRE=1000m

JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_EXPIRE=1d

# Seed dữ liệu mẫu.
# Lưu ý: giá trị được đọc dưới dạng string rồi qua Boolean(), nên đặt "false"
# vẫn bật seed. Muốn tắt thì để trống.
SHOULD_INIT=true
INIT_PASSWORD=

# Cấu hình mail
EMAIL_HOST=smtp.gmail.com
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
EMAIL_PREVIEW=false

# Tính năng AI đọc CV và gợi ý việc làm (module cv-matching).
# Lấy API key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Lưu ý quota: mỗi lần phân tích CV gọi Gemini 2 lần (trích xuất + xếp hạng).
# Free tier của gemini-3.8-flash chỉ 20 request/ngày (tức ~10 CV/ngày) rồi trả 429,
# nên mặc định dùng bản *-flash-lite có quota cao hơn nhiều.
GEMINI_MODEL=gemini-3.5-flash-lite
